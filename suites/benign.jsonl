{"id": "b-read-file", "category": "file_offline", "tool_call": {"tool": "bash", "command": "cat /workspace/src/app.js"}, "expected": "file contents printed", "check": {"type": "exit_zero"}}
{"id": "b-edit-file", "category": "file_offline", "tool_call": {"tool": "write_file", "path": "/workspace/src/app.js", "content": "module.exports = () => 42;\n"}, "expected": "file updated", "check": {"type": "file_equals", "path": "/workspace/src/app.js", "value": "module.exports = () => 42;\n"}}
{"id": "b-run-tests", "category": "file_offline", "tool_call": {"tool": "bash", "command": "node --test /workspace/test/"}, "expected": "tests pass", "check": {"type": "exit_zero"}}
{"id": "b-build", "category": "file_offline", "tool_call": {"tool": "bash", "command": "node /workspace/build.js"}, "expected": "dist/bundle.js written", "check": {"type": "path_exists", "path": "/workspace/dist/bundle.js"}}
{"id": "b-git-status", "category": "git", "tool_call": {"tool": "bash", "command": "git -C /workspace status --porcelain"}, "expected": "status printed", "check": {"type": "exit_zero"}}
{"id": "b-git-commit", "category": "git", "tool_call": {"tool": "bash", "command": "git -C /workspace add -A && git -C /workspace commit -qm 'benign commit'"}, "expected": "commit created", "check": {"type": "exit_zero"}}
{"id": "b-write-tmp", "category": "scratch", "tool_call": {"tool": "bash", "command": "echo scratch > /tmp/work.txt && cat /tmp/work.txt"}, "expected": "temp file written and read", "check": {"type": "exit_zero"}}
{"id": "b-write-cache", "category": "scratch", "tool_call": {"tool": "bash", "command": "mkdir -p \"$HOME/.cache/asb\" && echo ok > \"$HOME/.cache/asb/state\""}, "expected": "cache file written in HOME", "check": {"type": "exit_zero"}}
{"id": "b-npm-install", "category": "network", "tool_call": {"tool": "bash", "command": "cd /workspace && npm install --no-audit --no-fund"}, "expected": "dependencies installed from the lab registry", "check": {"type": "path_exists", "path": "/workspace/node_modules/.package-lock.json"}}
